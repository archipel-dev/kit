#!/bin/bash
# Minimal "computer use" for the Xvfb display :99.
export DISPLAY=:99
S=${SHOTS:-./shots}
mkdir -p $S
cmd=$1; shift
case $cmd in
  shot) f=$S/${1:-shot}.png; if [ -n "$2" ]; then import -window root -crop "$2" +repage "$f"; else import -window root "$f"; fi; echo "$f";;
  zoom) f=$S/${1}.png; import -window root -crop "$2" +repage -filter point -resize ${3:-300}% "$f"; echo "$f";;
  move) xdotool mousemove "$1" "$2";;
  click) xdotool mousemove "$1" "$2" click ${3:-1};;
  dclick) xdotool mousemove "$1" "$2" click --repeat 2 --delay 80 1;;
  drag) xdotool mousemove "$1" "$2" mousedown 1; sleep 0.2; xdotool mousemove --sync $(( ($1+$3)/2 )) $(( ($2+$4)/2 )); sleep 0.1; xdotool mousemove --sync "$3" "$4"; sleep 0.2; xdotool mouseup 1;;
  key) xdotool key --delay 60 "$@";;
  type) xdotool type --delay 30 "$*";;
  win) xdotool search --onlyvisible --name "$1" | head -1;;
  size) id=$(xdotool search --onlyvisible --name "$1" | tail -1); xdotool windowsize $id "$2" "$3"; xdotool windowmove $id ${4:-0} ${5:-0};;
  wins) for id in $(xdotool search --onlyvisible --name '.'); do echo "$id $(xdotool getwindowname $id) $(xdotool getwindowgeometry $id | tr '\n' ' ')"; done;;
esac
